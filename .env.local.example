# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Required for real analysis/rewrites. Without it the app runs in demo mode
# (offline stand-in logic — full workflow, no model calls).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-5
# DEMO_MODE=1   # force demo mode even with a key set
